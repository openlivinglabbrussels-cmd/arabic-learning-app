<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Colors -->
    <Color x:Key="PrimaryBlue">#1565C0</Color>
    <Color x:Key="PrimaryTeal">#00796B</Color>
    <Color x:Key="AccentGold">#F9A825</Color>
    <Color x:Key="AccentGoldLight">#FFF176</Color>
    <Color x:Key="BackgroundLight">#F5F7FA</Color>
    <Color x:Key="BackgroundDark">#1A237E</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextSecondary">#757575</Color>
    <Color x:Key="TextOnDark">#FFFFFF</Color>
    <Color x:Key="CorrectGreen">#2E7D32</Color>
    <Color x:Key="IncorrectRed">#C62828</Color>
    <Color x:Key="CorrectGreenLight">#E8F5E9</Color>
    <Color x:Key="IncorrectRedLight">#FFEBEE</Color>
    <Color x:Key="DividerColor">#E0E0E0</Color>
    <Color x:Key="ShadowColor">#22000000</Color>

    <!-- Gradient Colors -->
    <Color x:Key="GradientStart">#1565C0</Color>
    <Color x:Key="GradientEnd">#00796B</Color>

</ResourceDictionary>
