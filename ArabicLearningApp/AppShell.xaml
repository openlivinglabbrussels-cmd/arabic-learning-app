<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ArabicLearningApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ArabicLearningApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Learn Arabic">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource PrimaryBlue}" />
            <Setter Property="Shell.TabBarForegroundColor" Value="White" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="#88FFFFFF" />
            <Setter Property="Shell.TabBarTitleColor" Value="White" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="🏠"
            Route="HomePage"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Alphabet"
            Icon="🔤"
            Route="AlphabetPage"
            ContentTemplate="{DataTemplate views:AlphabetPage}" />

        <ShellContent
            Title="Vocabulary"
            Icon="📖"
            Route="VocabularyPage"
            ContentTemplate="{DataTemplate views:VocabularyPage}" />

        <ShellContent
            Title="Flashcards"
            Icon="🃏"
            Route="FlashcardPage"
            ContentTemplate="{DataTemplate views:FlashcardPage}" />

        <ShellContent
            Title="Quiz"
            Icon="📝"
            Route="QuizPage"
            ContentTemplate="{DataTemplate views:QuizPage}" />

        <ShellContent
            Title="Progress"
            Icon="📈"
            Route="ProgressPage"
            ContentTemplate="{DataTemplate views:ProgressPage}" />
    </TabBar>

</Shell>
