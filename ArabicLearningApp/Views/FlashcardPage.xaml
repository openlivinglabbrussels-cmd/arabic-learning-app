<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArabicLearningApp.Views.FlashcardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArabicLearningApp.ViewModels"
    Title="Flashcards"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="90">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
                        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <VerticalStackLayout VerticalOptions="Center" Padding="16,0">
                <Label Text="بِطَاقَات تَعلِيمِيَّة" Style="{StaticResource ArabicTextSmall}" TextColor="White" FontSize="22" />
                <Label x:Name="ProgressLabel" Text="1 / 10" TextColor="#CCE3F9" FontSize="13" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Category Picker -->
        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="8"
            Padding="12,8"
            HorizontalOptions="Center">
            <Label Text="Category:" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}" />
            <Picker
                x:Name="CategoryPicker"
                MinimumWidthRequest="180"
                FontSize="14"
                SelectedIndexChanged="OnCategoryChanged" />
            <Button Text="🔀 Shuffle" Style="{StaticResource SecondaryButton}" Padding="12,8" FontSize="13" Clicked="OnShuffleClicked" />
        </HorizontalStackLayout>

        <!-- Flashcard -->
        <Frame
            Grid.Row="2"
            x:Name="FlashcardFrame"
            Margin="20"
            Style="{StaticResource CardFrame}"
            CornerRadius="20"
            Padding="24"
            VerticalOptions="Fill">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </Frame.GestureRecognizers>
            <Grid>
                <!-- Front: Arabic Word -->
                <VerticalStackLayout
                    x:Name="FrontPanel"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="16">
                    <Label Text="Tap to reveal" TextColor="{StaticResource TextSecondary}" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="ArabicWordLabel"
                        FontSize="56"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBlue}"
                        FlowDirection="RightToLeft" />
                    <Label
                        x:Name="CardCategoryLabel"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Back: English + Transliteration -->
                <VerticalStackLayout
                    x:Name="BackPanel"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    IsVisible="False">
                    <Label Text="Translation" TextColor="{StaticResource TextSecondary}" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="EnglishWordLabel"
                        FontSize="32"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBlue}" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" HorizontalOptions="Fill" />
                    <Label Text="Transliteration" TextColor="{StaticResource TextSecondary}" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="TransliterationWordLabel"
                        FontSize="20"
                        Style="{StaticResource TransliterationLabel}" />
                    <Label
                        x:Name="BackArabicLabel"
                        FontSize="28"
                        TextColor="{StaticResource PrimaryBlue}"
                        FlowDirection="RightToLeft"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*" Padding="16,0,16,16" ColumnSpacing="12">
            <Button
                Grid.Column="0"
                Text="◀ Previous"
                Style="{StaticResource OutlineButton}"
                Clicked="OnPreviousClicked" />
            <Button
                Grid.Column="1"
                Text="↩ Flip"
                Style="{StaticResource SecondaryButton}"
                Clicked="OnFlipClicked"
                MinimumWidthRequest="80" />
            <Button
                Grid.Column="2"
                Text="Next ▶"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnNextClicked" />
        </Grid>

    </Grid>
</ContentPage>
