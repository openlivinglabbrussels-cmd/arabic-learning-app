<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArabicLearningApp.Views.VocabularyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArabicLearningApp.ViewModels"
    xmlns:models="clr-namespace:ArabicLearningApp.Models"
    Title="Vocabulary"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="90">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
                        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <VerticalStackLayout VerticalOptions="Center" Padding="16,0">
                <Label Text="المُفرَدَات" Style="{StaticResource ArabicTextSmall}" TextColor="White" FontSize="22" />
                <Label x:Name="PageSubtitle" Text="Choose a category to study" TextColor="#CCE3F9" FontSize="13" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Categories List -->
            <CollectionView
                x:Name="CategoriesView"
                Margin="12"
                SelectionMode="None"
                IsVisible="True">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LessonCategory">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="36" VerticalOptions="Center" Margin="0,0,12,0" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding ArabicName}" FontSize="16" TextColor="{StaticResource PrimaryBlue}" FlowDirection="RightToLeft" HorizontalTextAlignment="Start" />
                                    <Label Text="{Binding TotalItems, StringFormat='{0} words'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="✅" FontSize="20" VerticalOptions="Center" IsVisible="{Binding IsCompleted}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Vocabulary Items -->
            <Grid x:Name="VocabView" IsVisible="False" RowDefinitions="Auto,*,Auto">
                <Button
                    Grid.Row="0"
                    Text="← Back to Categories"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnBackToCategoriesClicked"
                    Margin="12,8"
                    HorizontalOptions="Start" />

                <CollectionView
                    Grid.Row="1"
                    x:Name="VocabItemsView"
                    Margin="12,0"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VocabularyItem">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="{Binding ArabicWord}"
                                        FontSize="32"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{StaticResource PrimaryBlue}"
                                        FlowDirection="RightToLeft" />
                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" />
                                    <Label
                                        Text="{Binding EnglishTranslation}"
                                        Style="{StaticResource EnglishLabelPrimary}"
                                        FontSize="15" />
                                    <Label
                                        Text="{Binding Transliteration}"
                                        Style="{StaticResource TransliterationLabel}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    Grid.Row="2"
                    x:Name="MarkDoneButton"
                    Text="✅ Mark Category Complete"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnMarkDoneClicked"
                    Margin="12,8"
                    HorizontalOptions="Fill" />
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
