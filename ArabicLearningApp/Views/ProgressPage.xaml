<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArabicLearningApp.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArabicLearningApp.ViewModels"
    xmlns:models="clr-namespace:ArabicLearningApp.Models"
    Title="My Progress"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="90">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
                        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <VerticalStackLayout VerticalOptions="Center" Padding="16,0">
                <Label Text="تَقدُّمِي" Style="{StaticResource ArabicTextSmall}" TextColor="White" FontSize="22" />
                <Label Text="Track your learning journey" TextColor="#CCE3F9" FontSize="13" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Overall Progress Card -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Overall Progress" Style="{StaticResource SectionHeader}" Margin="0" FontSize="18" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar
                                x:Name="OverallProgressBar"
                                Grid.Column="0"
                                Progress="0"
                                ProgressColor="{StaticResource PrimaryBlue}"
                                VerticalOptions="Center"
                                HeightRequest="12" />
                            <Label
                                x:Name="OverallProgressText"
                                Grid.Column="1"
                                Text="0%"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryBlue}"
                                VerticalOptions="Center"
                                Margin="10,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">

                    <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFrame}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="📖" FontSize="28" HorizontalTextAlignment="Center" />
                            <Label x:Name="CompletedCatsLabel" Text="0/7" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Categories Done" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource CardFrame}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="🔤" FontSize="28" HorizontalTextAlignment="Center" />
                            <Label x:Name="AlphabetLabel" Text="—" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Alphabet Viewed" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource CardFrame}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="📝" FontSize="28" HorizontalTextAlignment="Center" />
                            <Label x:Name="QuizzesTakenLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalTextAlignment="Center" />
                            <Label Text="Quizzes Taken" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource CardFrame}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="⭐" FontSize="28" HorizontalTextAlignment="Center" />
                            <Label x:Name="AvgScoreLabel" Text="0%" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AccentGold}" HorizontalTextAlignment="Center" />
                            <Label Text="Avg Quiz Score" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Category Progress -->
                <Label Text="Category Progress" Style="{StaticResource SectionHeader}" />
                <CollectionView x:Name="CategoryProgressView" HeightRequest="300" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LessonCategory">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,2" Padding="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding TotalItems, StringFormat='{0} words'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="✅" FontSize="20" VerticalOptions="Center" IsVisible="{Binding IsCompleted}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Recent Quiz Results -->
                <Label Text="Recent Quizzes" Style="{StaticResource SectionHeader}" />
                <CollectionView x:Name="RecentQuizzesView" HeightRequest="200" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuizResult">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,2" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy HH:mm}'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding DisplayScore}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" VerticalOptions="Center" Margin="0,0,12,0" />
                                    <Label Grid.Column="2" Text="{Binding DisplayPercentage}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryTeal}" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Reset Button -->
                <Button
                    Text="🗑️ Reset All Progress"
                    Style="{StaticResource OutlineButton}"
                    TextColor="{StaticResource IncorrectRed}"
                    BorderColor="{StaticResource IncorrectRed}"
                    Clicked="OnResetClicked"
                    HorizontalOptions="Fill"
                    Margin="0,8" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
